# ===========================================================================
# La Mother Express — variables d'environnement
#
# Copier en `.env.local` pour le développement. En production, les renseigner
# dans le coffre de secrets de l'hébergeur (Azure Key Vault / variables
# secrètes de Container Apps, OVHcloud Secret Manager, Vercel Environment
# Variables) — JAMAIS dans un fichier versionné.
#
# Marqués [PROD] : obligatoires en production, l'application refuse de
# démarrer les opérations concernées sans eux.
# ===========================================================================

# ── Base de données ────────────────────────────────────────────────────────
# [PROD] PostgreSQL 15+. Exiger TLS : ?sslmode=require
DATABASE_URL="postgresql://user:password@hote:5432/lme?sslmode=require"
# Connexions max par instance. 10 en conteneur, 1 à 3 en serverless.
DATABASE_POOL_MAX="10"

NEXT_PUBLIC_SITE_URL="https://lamotherexpress.com"

# ── Secrets ────────────────────────────────────────────────────────────────
# [PROD] openssl rand -hex 32 — au moins 32 caractères.
# En dérivent : la clé des sessions et celle des codes OTP. Le changer
# déconnecte tout le monde et annule les codes en attente.
AUTH_SECRET=""
# Back-office catalogue V1
ADMIN_AUTH_SECRET=""

# ── Réseau ─────────────────────────────────────────────────────────────────
# Nombre de proxys de confiance devant l'application (lecture de l'IP réelle
# dans x-forwarded-for, depuis la droite). 1 : Vercel, Azure Container Apps,
# load balancer OVH. 2 : CDN + load balancer. 0 : exposition directe.
PROXY_SAUTS_DE_CONFIANCE="1"

# SMS : console (dev uniquement) | dexchange | infobip | twilio | orange
SMS_DRIVER="dexchange"

# ── Dexchange — la route du Sénégal ────────────────────────────────────────
# Fournisseur dakarois. Expéditeur « LM-EXPRESS » validé le 2026-11-03 et SMS
# reçus sur Orange (77), Expresso (70) et Free (76) : le SEUL fournisseur dont
# la livraison au Sénégal soit établie.
DEXCHANGE_API_KEY=""
# Signature = l'expéditeur affiché. Repli côté fournisseur : "DSMS SN".
#
# Le TIRET est significatif : "LM-EXPRESS" est la syntaxe validée par Dexchange
# et confirmée par Alexandre le 2026-11-04. Un caractère d'écart et l'envoi est
# refusé. (D'autres plateformes n'acceptent que lettres et chiffres dans un
# expéditeur alphanumérique, d'où un « LMEXPRESS » sans tiret ailleurs : ce
# n'est pas la bonne valeur ici.)
DEXCHANGE_SIGNATURE="LM-EXPRESS"
# À laisser vide sauf changement : https://api.dexchange-sms.com/api/v1
DEXCHANGE_BASE_URL=""
#
# PIÈGE : leur documentation annonce `X-Api-Key` et dit `Bearer` déprécié.
# C'est l'inverse — seul Bearer est accepté, le reste répond 401 (constaté les
# 2026-10-23 et 2026-11-03). Le jour où leur migration aboutit, basculer vers
# DEXCHANGE_AUTH_HEADER="X-Api-Key" et DEXCHANGE_AUTH_PREFIX="".
DEXCHANGE_AUTH_HEADER="Authorization"
DEXCHANGE_AUTH_PREFIX="Bearer "
#
# Compte PRÉPAYÉ : sans crédit, plus aucune connexion ni signature. Seuil
# d'alerte de `npm run verif:solde`, en SMS restants (200 par défaut).
SMS_BALANCE_THRESHOLD="200"

# Anti-fraude SMS : pays autorisés (codes ISO, séparés par des virgules).
# Vide = tous. Les visiteurs des autres pays se connectent par e-mail — ils ne
# sont jamais bloqués, seul le SMS leur est fermé.
#
# Les 54 États d'Afrique, plus les pays d'où viennent les visiteurs habituels.
# Plus la liste est large, plus la surface de fraude au SMS surtaxé l'est aussi :
# c'est OTP_PLAFOND_SMS_HEURE qui reste le vrai coupe-circuit.
# À compléter au besoin : RE (Réunion), YT (Mayotte), EH (Sahara occidental).
#
# ⚠ Cette liste autorise plus de pays que Dexchange n'en couvre de façon
# éprouvée. Seul le Sénégal l'est : un numéro étranger part donc chez eux sans
# qu'on sache s'il arrive. Pour TESTER, utiliser un numéro sénégalais — un
# numéro français ne prouverait rien. Restreindre à "SN" suppose que la
# connexion par e-mail fonctionne, ce qui n'est pas encore le cas.
SMS_PAYS_AUTORISES="SN,AO,BF,BI,BJ,BW,CD,CF,CG,CI,CM,CV,DJ,DZ,EG,ER,ET,GA,GH,GM,GN,GQ,GW,KE,KM,LR,LS,LY,MA,MG,ML,MR,MU,MW,MZ,NA,NE,NG,RW,SC,SD,SL,SO,SS,ST,SZ,TD,TG,TN,TZ,UG,ZA,ZM,ZW,BE,CA,CH,DE,ES,FR,GB,IT,US"
# Plafond global de SMS par heure, tous numéros confondus (coupe-circuit).
OTP_PLAFOND_SMS_HEURE="300"

# ── Déploiement sans machine persistante (Vercel et assimilés) ─────────────
# Secret du cron d'expiration. La route /api/cron/expiration SE DÉSACTIVE sans
# lui, plutôt que de libérer des motos sur simple appel public — donc sans ce
# secret, les réservations non retirées restent bloquées indéfiniment.
#   openssl rand -hex 24
CRON_SECRET=""

# Connexions PostgreSQL par instance. En serverless, chaque instance ouvre son
# propre pool et la plateforme en démarre autant que le trafic l'exige : 10 par
# instance saturent une base managée en quelques dizaines d'instances.
# Serverless : 1 à 3, et passer par le pooler du fournisseur. Serveur classique
# qui tourne en continu : 10 convient.
DATABASE_POOL_MAX="10"

# E-mail : console (dev uniquement) | smtp
#
# Fournisseur À CHOISIR. Infobip a été retiré le 2026-11-04 avec son SMS, et
# Dexchange ne fait pas d'e-mail. Le pilote `smtp` accepte n'importe quel
# service — Brevo, Mailjet, Amazon SES, OVH, Scaleway TEM — donc ce choix ne
# demande aucun code, seulement ces quatre variables.
#
# Le TLS est obligatoire sur tous les ports : 587 passe par STARTTLS, 465 est
# chiffré d'emblée. Quel que soit le service, il faudra VÉRIFIER LE DOMAINE
# d'envoi avant que le moindre message parte : c'est une formalité DNS, pas du
# code, et elle prend jusqu'à 48 h.
EMAIL_DRIVER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Sous-domaine DÉDIÉ à l'envoi (décision du 2026-10-02) : il isole la
# réputation d'expédition du domaine principal, et surtout aucun enregistrement
# de la racine n'est touché — le site V1 ne peut donc pas être affecté.
EMAIL_EXPEDITEUR="La Mother Express <no-reply@email.lamotherexpress.com>"

# ── Suivi des versements ───────────────────────────────────────────────────
# [PROD] Date de mise en service du suivi (AAAA-MM-JJ). Les encaissements
# antérieurs ne sont pas repris : sans cette borne, un contrat signé des mois
# plus tôt afficherait un retard qu'il n'a pas. Vide : chaque contrat est suivi
# depuis son scellement (développement).
SUIVI_VERSEMENTS_DEPUIS=""

# ── Stockage des pièces d'identité et des contrats ─────────────────────────
# local (dev) | vercel | s3 | azure
#
# `vercel` est le choix retenu le 2026-11-05 — tout reste sur une plateforme.
# `local` est INOPÉRANT sur Vercel : pas de disque persistant.
STORAGE_DRIVER="vercel"

# [PROD] Trousseau de chiffrement AES-256-GCM. La première clé chiffre, toutes
# déchiffrent. Chaque clé : openssl rand -base64 32
# PERDRE CES CLÉS = PERDRE TOUS LES DOCUMENTS. Les sauvegarder dans le coffre
# de secrets ET hors ligne.
STORAGE_CLES_CHIFFREMENT="k2026a:REMPLACER_PAR_32_OCTETS_BASE64"
# Préfixe facultatif des chemins (partage d'un bucket entre environnements)
STORAGE_PREFIXE=""

# S3 — OVHcloud : https://s3.gra.io.cloud.ovh.net / gra
#      Scaleway : https://s3.fr-par.scw.cloud / fr-par
#      AWS      : endpoint vide / eu-west-3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
# Chiffrement côté fournisseur en plus du nôtre (facultatif) : AES256
S3_CHIFFREMENT_SERVEUR=""

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER=""

# Vercel Blob — le stockage retenu.
#
# Le jeton est injecté AUTOMATIQUEMENT par Vercel sur sa plateforme : ne le
# renseigner que pour travailler hors Vercel.
BLOB_READ_WRITE_TOKEN=""
#
# [PROD] OBLIGATOIRE avec le pilote `vercel`, et le pilote REFUSE de démarrer
# sans lui en production. Les blobs sont écrits en accès PRIVÉ — une URL seule
# ne donne rien — donc ce sel n'est plus la barrière principale. Il rend les
# chemins non devinables, une couche de plus qui ne coûte rien, et se dégrader
# en silence sur un stockage de pièces d'identité n'est pas acceptable.
#   openssl rand -hex 16
STORAGE_PATH_SALT=""

# ── Purge des pièces d'identité ────────────────────────────────────────────
# Délai en HEURES après le RETRAIT COMPLET — contrat signé des deux côtés, état
# des lieux fait, moto livrée — au terme duquel l'IMAGE de la pièce est
# effacée. 48 h par défaut, règle arrêtée par Alexandre.
#
# Le déclencheur est la LIVRAISON et non la fin du contrat : la pièce sert à
# vérifier au retrait que la personne est bien celle qu'elle prétend. Ce
# service rendu, la garder vingt-quatre mois ne protège personne.
#
# Ce qui reste en base : le type, la taille, la date de dépôt et le SHA-256 —
# de quoi prouver qu'on a vérifié, et même de confirmer plus tard qu'une pièce
# présentée est bien celle qu'on a vue. L'identité elle-même survit dans le
# contrat scellé, qui n'est jamais purgé.
#
# Un client qui a encore un dossier en attente de retrait n'est jamais purgé :
# le gérant doit pouvoir regarder sa pièce.
PURGE_PIECES_HEURES="48"
